# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/brandvault?sslmode=require"
DIRECT_URL="postgresql://user:password@localhost:5432/brandvault?sslmode=require"

# Auth & App Config
AUTH_SECRET="your-secret-jwt-key"
APP_URL="http://localhost:3000"

# Optional Seed Credentials
DEMO_EMAIL="example@domain.com"
DEMO_PASSWORD="your-password"

# GenAI Configuration (Groq / OpenAI compatible)
AI_PROVIDER="groq"
AI_API_KEY="paste_groq_api_key_here"
AI_MODEL="openai/gpt-oss-20b"

# Optional n8n Webhook Integration
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/example"